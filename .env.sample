# --- Client (Vite; exposed in the browser — use an API key restricted by HTTP referrer) ---
VITE_GOOGLE_API_KEY=your_google_cloud_api_key
VITE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_ExampleId

# Production asset base path (GitHub Pages project site is usually /repository-name/)
# Dev server always uses /. Omit or use / for root-hosted builds.
VITE_BASE_PATH=/buildapage-template/

# Optional: localStorage cache TTL in seconds (default 3600 if unset)
# VITE_CACHE_TIMEOUT_SECONDS=3600

# Optional: set to 0 to disable localStorage cache at build time
# VITE_CACHE=0

# Optional: Git remote for gh-pages when your deploy uses --repo (see README)
# REPO_URL=https://github.com/username/repo.git
